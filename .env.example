# 05 §4.3, §5.6 — port 5433 so this never collides with another local Postgres;
# bound to 127.0.0.1 because V1 has no authentication.
PKE_DATABASE_URL=postgres://pke:pke_local@127.0.0.1:5433/pke

# 05 §5.4 — blob path is configurable; no hardcoded paths in code.
PKE_BLOB_DIR=./storage/blobs

# 05 §5.4, §8 — optional HTTP transport bind.
PKE_HTTP_HOST=127.0.0.1
PKE_HTTP_PORT=8377
